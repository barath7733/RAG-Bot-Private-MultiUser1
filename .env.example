# --- Groq (LLM) -----------------------------------------------------
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Any current Groq-hosted chat model, e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# --- Pinecone (vector database) -------------------------------------
# Get a key from https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-chatbot-index
# Serverless index region/cloud (adjust to your Pinecone plan)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embeddings (Gemini Embedding API) --------------------------------
# Get a key from https://aistudio.google.com/apikey
# Used to embed document chunks and queries for RAG retrieval.
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001

# --- Chunking / retrieval tuning -------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.30

# --- Web search (current/real-time info, optional but needed for Web Search mode) ---
# Free tier key from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
WEB_SEARCH_MAX_RESULTS=5

# --- Image generation ---------------------------------------------------
# Uses Pollinations.ai (free, no API key required). Model options include
# "flux" (default, higher quality) and "turbo" (faster).
IMAGE_GEN_MODEL=flux

# --- Uploads -----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=data/pdfs

# --- Authentication / user sessions --------------------------------------
# REQUIRED in any real deployment. Signs the login session (JWT) cookie.
# Generate one with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_long_random_secret_value
# How long a login session lasts before the user must log in again (minutes).
# Default: 10080 = 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Set to "true" once you're serving the app over HTTPS in production, so the
# session cookie is only ever sent over an encrypted connection. Keep "false"
# for local http://localhost development.
COOKIE_SECURE=false

# --- Database (user accounts, documents metadata, chat history) ----------
# Default: a local SQLite file. Point this at Postgres/MySQL in production,
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# --- App / server ------------------------------------------------------
APP_ENV=development
# Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
